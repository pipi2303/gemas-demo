# Konfigurasi lokal (npm run dev) -- untuk env production lewat Docker Compose,
# lihat docker-compose.yml + DEPLOY.md (var di-inject Portainer dari GitHub
# Secrets, BUKAN dari file .env di server).

# String koneksi Postgres. Kalau kosong, server jalan pakai in-memory storage
# fallback (hanya untuk dev/demo cepat -- data hilang tiap restart, JANGAN
# dipakai di production).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gemas_dev

# WAJIB diisi, minimal 32 karakter, string acak (bukan kata yang mudah ditebak).
# Dipakai untuk sign JWT login DAN enkripsi backup (server/lib/jwt.ts,
# server/routes/backup.ts) -- production menolak start kalau ini kosong/pendek
# (lihat validateEnv() di server/index.ts).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Origin frontend yang boleh mengakses API ini (CORS). Kosongkan untuk dev
# lokal (semua origin diizinkan); WAJIB diisi persis dengan domain publik di
# production (mis. https://gemas.contoh.org) -- lihat server/app.ts, origin di
# luar daftar ini sekarang ditolak (bukan cuma dicek lalu diloloskan juga).
CLIENT_ORIGIN=

# development | production. Mempengaruhi cookie secure/sameSite (server/routes/
# auth.ts) dan apakah JWT_SECRET wajib diisi (server/lib/jwt.ts). Port server
# tetap 3000 (hardcoded di server/index.ts, tidak dibaca dari env).
NODE_ENV=development
